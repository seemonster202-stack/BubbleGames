<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gemini AI Chat</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f4f9; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .chat-container { width: 450px; background: white; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); display: flex; flex-direction: column; overflow: hidden; height: 80vh; }
        .config-bar { padding: 10px; background: #333; color: white; display: flex; gap: 5px; }
        .config-bar input { flex: 1; padding: 5px; border-radius: 4px; border: none; }
        .chat-box { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
        .message { padding: 10px; border-radius: 6px; max-width: 80%; word-wrap: break-word; }
        .user { background: #007bff; color: white; align-self: flex-end; }
        .ai { background: #e9e9eb; color: black; align-self: flex-start; }
        .input-area { display: flex; border-top: 1px solid #ddd; padding: 10px; background: #fff; }
        .input-area input { flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 4px; outline: none; }
        .input-area button { background: #007bff; color: white; border: none; padding: 10px 15px; margin-left: 5px; border-radius: 4px; cursor: pointer; }
    </style>
</head>
<body>

<div class="chat-container">
    <div class="config-bar">
        <input type="password" id="apiKey" placeholder="Paste Gemini API Key here...">
    </div>
    <div class="chat-box" id="chatBox">
        <div class="message ai">Hello! Provide your API key above, type a message, and let's chat.</div>
    </div>
    <div class="input-area">
        <input type="text" id="userInput" placeholder="Type a message..." onkeypress="if(event.key === 'Enter') sendMessage()">
        <button onclick="sendMessage()">Send</button>
    </div>
</div>

<!-- Import the official Google Gen AI SDK -->
<script type="importmap">
  {
    "imports": {
      "@google/genai": "https://esm.run"
    }
  }
</script>

<script type="module">
    import { GoogleGenAI } from "@google/genai";

    let conversationHistory = [];

    window.sendMessage = async function() {
        const apiKeyInput = document.getElementById('apiKey').value.trim();
        const userInputField = document.getElementById('userInput');
        const userText = userInputField.value.trim();
        const chatBox = document.getElementById('chatBox');

        if (!apiKeyInput) {
            alert("Please enter your Gemini API key first.");
            return;
        }
        if (!userText) return;

        // Append user message to UI
        appendMessage(userText, 'user');
        userInputField.value = '';

        // Add user message to history
        conversationHistory.push({ role: 'user', parts: [{ text: userText }] });

        try {
            // Initialize the SDK with the provided key
            const ai = new GoogleGenAI({ apiKey: apiKeyInput });
            
            // Call the standard flash model
            const response = await ai.models.generateContent({
                model: 'gemini-2.5-flash', 
                contents: conversationHistory
            });

            const aiText = response.text;
            
            // Append AI response to UI and history
            appendMessage(aiText, 'ai');
            conversationHistory.push({ role: 'model', parts: [{ text: aiText }] });

        } catch (error) {
            console.error(error);
            appendMessage("Error: Failed to connect to Gemini. Check your API key or console log.", 'ai');
        }
    }

    function appendMessage(text, sender) {
        const chatBox = document.getElementById('chatBox');
        const msgDiv = document.createElement('div');
        msgDiv.classList.add('message', sender);
        msgDiv.innerText = text;
        chatBox.appendChild(msgDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
    }
</script>

</body>
</html>
